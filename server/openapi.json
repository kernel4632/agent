{
  "openapi": "3.1.0",
  "info": {
    "title": "Universal Agent 后端接口文档",
    "version": "0.1.0",
    "description": "这个文档列出了所有可以调用的接口。每个接口都说明了：要发什么数据、会收到什么数据、以及这个接口是做什么用的。"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "本地开发服务器，默认端口 3000"
    }
  ],
  "tags": [
    {
      "name": "Agent",
      "description": "控制 AI 执行任务。启动任务、停止任务、审批工具调用。"
    },
    {
      "name": "Session",
      "description": "管理对话记录。创建、读取、重命名、删除对话，以及撤销和压缩历史消息。"
    },
    {
      "name": "Config",
      "description": "读取和保存全局配置，比如 AI 模型和系统提示词。"
    },
    {
      "name": "SSE",
      "description": "建立实时事件连接。服务器会持续把 AI 的输出推送给你。SSE 是 Server-Sent Events 的缩写，意思是服务器主动推送消息。"
    }
  ],
  "paths": {
    "/agent/send/{sessionId}": {
      "post": {
        "tags": ["Agent"],
        "summary": "发送消息，启动 AI 任务",
        "description": "向指定会话发送一条用户消息，AI 会在后台开始工作。任务执行过程中的所有输出，都会通过 GET /sse/connect/{sessionId} 推送过来，这个接口本身只返回 { ok: true }。同一个会话同时只能运行一个任务，重复调用会返回 409 错误。",
        "operationId": "agentSend",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "description": "会话的唯一编号，由 POST /session/create 创建时返回",
            "schema": {
              "type": "string",
              "example": "V1StGXR8_Z5jdHi6B-myT"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["input"],
                "properties": {
                  "input": {
                    "type": "string",
                    "description": "你要发给 AI 的消息内容，不能为空",
                    "example": "帮我写一个读取文件的 Python 脚本"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已成功启动，AI 开始在后台运行",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求数据有问题，比如 input 是空字符串",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "404": {
            "description": "找不到这个 sessionId 对应的会话",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "409": {
            "description": "这个会话的 AI 任务已经在运行中，不能同时启动第二个",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/agent/stop/{sessionId}": {
      "post": {
        "tags": ["Agent"],
        "summary": "停止正在运行的 AI 任务",
        "description": "立即终止指定会话中正在执行的 AI 任务。如果这个会话当前没有任务在运行，返回 { ok: false }；停止成功返回 { ok: true }。",
        "operationId": "agentStop",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "description": "会话的唯一编号",
            "schema": {
              "type": "string",
              "example": "V1StGXR8_Z5jdHi6B-myT"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "操作完成。ok 为 true 表示成功停止，ok 为 false 表示当前没有任务在运行",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/agent/decide/{sessionId}": {
      "post": {
        "tags": ["Agent"],
        "summary": "审批 AI 使用工具的请求",
        "description": "当 AI 需要调用某个工具时，如果配置了审批规则，服务器会通过 SSE 推送一个 permission 事件，里面包含 callId。你需要调用这个接口告诉服务器同意还是拒绝。decision 为 true 表示同意，false 表示拒绝。",
        "operationId": "agentDecide",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "description": "会话的唯一编号",
            "schema": {
              "type": "string",
              "example": "V1StGXR8_Z5jdHi6B-myT"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["callId", "decision"],
                "properties": {
                  "callId": {
                    "type": "string",
                    "description": "工具调用的编号，从 SSE permission 事件的 callID 字段获取",
                    "example": "toolu_01XFx8EsZFm5kMvW8s6TuGHq"
                  },
                  "decision": {
                    "type": "boolean",
                    "description": "true 表示同意 AI 使用这个工具，false 表示拒绝",
                    "example": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "审批结果已处理。ok 为 true 表示找到了对应的等待审批记录，ok 为 false 表示找不到",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sse/connect/{sessionId}": {
      "get": {
        "tags": ["SSE"],
        "summary": "建立实时事件连接，接收 AI 的输出",
        "description": "建立一个持续的连接，服务器会把 AI 运行过程中的所有事件推送过来。连接断开后会自动重连，之前没收到的事件也会补发。这个连接没有固定的结束时间，会一直保持直到你主动断开。\n\n服务器推送的事件类型如下：\n- **text-delta**：AI 正在生成文字，每次推送一小段\n- **tool-call**：AI 正在调用某个工具\n- **tool-output**：工具的原始输出\n- **tool-result**：工具执行的最终结果\n- **permission**：AI 请求你审批是否允许使用某个工具\n- **retry**：因为错误正在重试\n- **compress-delta**：AI 正在压缩历史记录，推送压缩过程的文字\n- **finish**：任务结束\n- **error**：任务因为错误终止",
        "operationId": "sseConnect",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "description": "会话的唯一编号",
            "schema": {
              "type": "string",
              "example": "V1StGXR8_Z5jdHi6B-myT"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功建立 SSE 连接，服务器开始推送事件",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "SSE 格式的事件流。每个事件是一段 JSON 数据，格式为 data: {...}\\n\\n",
                  "example": "data: {\"type\":\"text-delta\",\"text\":\"好的，\"}\n\ndata: {\"type\":\"finish\",\"steps\":1}\n\n"
                },
                "examples": {
                  "text-delta": {
                    "summary": "AI 生成文字的片段",
                    "value": "data: {\"type\":\"text-delta\",\"text\":\"好的，我来帮你\"}\n\n"
                  },
                  "tool-call": {
                    "summary": "AI 调用工具",
                    "value": "data: {\"type\":\"tool-call\",\"toolCallId\":\"toolu_01\",\"toolName\":\"read_file\",\"args\":{\"path\":\"./index.js\"}}\n\n"
                  },
                  "permission": {
                    "summary": "AI 请求审批工具调用",
                    "value": "data: {\"type\":\"permission\",\"callID\":\"toolu_01\",\"tool\":\"delete_file\",\"input\":{\"path\":\"./old.js\"}}\n\n"
                  },
                  "finish": {
                    "summary": "任务完成",
                    "value": "data: {\"type\":\"finish\",\"steps\":3,\"usage\":{\"promptTokens\":1200,\"completionTokens\":400}}\n\n"
                  },
                  "error": {
                    "summary": "任务出错",
                    "value": "data: {\"type\":\"error\",\"message\":\"Provider not found: openai\",\"name\":\"Error\"}\n\n"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/session/create": {
      "post": {
        "tags": ["Session"],
        "summary": "新建一个对话",
        "description": "创建一个新的对话，返回这个对话的唯一编号 sessionId。之后所有操作都用这个编号来指定是哪个对话。",
        "operationId": "sessionCreate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title"],
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "这个对话的名称，不能为空",
                    "example": "写爬虫"
                  },
                  "workspaceId": {
                    "type": "string",
                    "description": "工作区编号（可选）",
                    "example": "workspace-01"
                  },
                  "provider": {
                    "type": "string",
                    "description": "指定使用哪个 AI 服务商（可选）。不填时使用配置里第一个启用的服务商",
                    "example": "anthropic"
                  },
                  "model": {
                    "type": "string",
                    "description": "指定使用哪个 AI 模型（可选）。不填时使用该服务商的第一个模型",
                    "example": "[REDACTED]"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "对话创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sessionId": {
                      "type": "string",
                      "description": "新建对话的唯一编号，后续所有操作都需要这个值",
                      "example": "V1StGXR8_Z5jdHi6B-myT"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "title 不能为空或不是字符串",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/session/read/{sessionId}": {
      "get": {
        "tags": ["Session"],
        "summary": "读取一个对话的全部内容",
        "description": "返回这个对话的基本信息和完整的消息历史记录。history 是一个消息列表，每条消息都有 role（角色）和 content（内容）。",
        "operationId": "sessionRead",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "description": "会话的唯一编号",
            "schema": {
              "type": "string",
              "example": "V1StGXR8_Z5jdHi6B-myT"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回对话信息",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "404": {
            "description": "找不到这个 sessionId 对应的对话",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/session/rename/{sessionId}": {
      "patch": {
        "tags": ["Session"],
        "summary": "给对话改名",
        "description": "修改指定对话的名称，返回更新后的对话信息（不含消息历史）。",
        "operationId": "sessionRename",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "description": "会话的唯一编号",
            "schema": {
              "type": "string",
              "example": "V1StGXR8_Z5jdHi6B-myT"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title"],
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "新的对话名称，不能为空",
                    "example": "写爬虫脚本"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "改名成功，返回更新后的对话基本信息",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionMeta"
                }
              }
            }
          },
          "400": {
            "description": "title 不能为空",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "404": {
            "description": "找不到这个 sessionId",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/session/remove/{sessionId}": {
      "delete": {
        "tags": ["Session"],
        "summary": "删除一个对话",
        "description": "永久删除指定的对话及其所有消息记录。这个操作不可撤销。",
        "operationId": "sessionRemove",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "description": "会话的唯一编号",
            "schema": {
              "type": "string",
              "example": "V1StGXR8_Z5jdHi6B-myT"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "找不到这个 sessionId",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/session/rollback/{sessionId}": {
      "post": {
        "tags": ["Session"],
        "summary": "回退到某条消息之前的状态",
        "description": "把对话历史回退到指定消息 messageId 出现之前的状态。这个操作会先停止当前正在运行的 AI 任务，再执行回退。回退后返回新的消息历史。",
        "operationId": "sessionRollback",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "description": "会话的唯一编号",
            "schema": {
              "type": "string",
              "example": "V1StGXR8_Z5jdHi6B-myT"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["messageId"],
                "properties": {
                  "messageId": {
                    "type": "string",
                    "description": "要回退到这条消息之前。这条消息和它之后的所有消息都会被移除",
                    "example": "msg_01ABC"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "回退成功，返回回退后的完整对话内容",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "404": {
            "description": "找不到这个 sessionId",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/session/redo/{sessionId}": {
      "post": {
        "tags": ["Session"],
        "summary": "撤销上一次回退",
        "description": "把刚才通过 rollback 移除的消息重新恢复回来。只能撤销最近一次回退。",
        "operationId": "sessionRedo",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "description": "会话的唯一编号",
            "schema": {
              "type": "string",
              "example": "V1StGXR8_Z5jdHi6B-myT"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "撤销回退成功，返回恢复后的完整对话内容",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "404": {
            "description": "找不到这个 sessionId",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/session/compact/{sessionId}": {
      "post": {
        "tags": ["Session"],
        "summary": "压缩对话历史，减少 token 用量",
        "description": "当对话历史太长时，让 AI 把之前的内容总结成一段简短的文字，替换掉原来的长历史。这样可以节省后续调用时消耗的 token 数量（token 可以理解为 AI 处理文字的计费单位）。压缩过程中会通过 SSE 推送 compress-delta 事件。",
        "operationId": "sessionCompact",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "description": "会话的唯一编号",
            "schema": {
              "type": "string",
              "example": "V1StGXR8_Z5jdHi6B-myT"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "maxTokens": {
                    "type": "integer",
                    "description": "压缩后的历史记录最多允许占用多少 token（可选）",
                    "example": 8000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "压缩完成，返回压缩后的完整对话内容",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "404": {
            "description": "找不到这个 sessionId",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/config/read": {
      "get": {
        "tags": ["Config"],
        "summary": "读取当前全局配置",
        "description": "返回服务器当前正在使用的全部配置，包括 AI 服务商、模型列表、系统提示词、权限规则等。",
        "operationId": "configRead",
        "responses": {
          "200": {
            "description": "成功返回当前配置",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Config"
                }
              }
            }
          }
        }
      }
    },
    "/config/set": {
      "patch": {
        "tags": ["Config"],
        "summary": "保存新的全局配置",
        "description": "用你提交的配置完全替换当前配置，并写入磁盘。注意：这是完全替换，不是合并，提交的内容就是保存后的内容，原来的配置不会保留。",
        "operationId": "configSet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Config"
              },
              "example": {
                "providers": [
                  {
                    "name": "anthropic",
                    "baseURL": "https://api.anthropic.com",
                    "apiKey": "sk-ant-xxxxx",
                    "models": ["[REDACTED]"],
                    "enabled": true
                  }
                ],
                "prompt": {
                  "system": "你是一个编程助手。"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "配置保存成功，返回保存后的完整配置",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Config"
                }
              }
            }
          },
          "400": {
            "description": "提交的数据不是一个合法的 JSON 对象",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "description": "接口出错时返回的错误信息",
        "properties": {
          "error": {
            "type": "string",
            "description": "错误的文字说明",
            "example": "Session not found: V1StGXR8_Z5jdHi6B-myT"
          }
        }
      },
      "SessionMeta": {
        "type": "object",
        "description": "对话的基本信息，不含消息历史",
        "properties": {
          "id": {
            "type": "string",
            "description": "对话的唯一编号",
            "example": "V1StGXR8_Z5jdHi6B-myT"
          },
          "title": {
            "type": "string",
            "description": "对话名称",
            "example": "写爬虫"
          },
          "workspaceId": {
            "type": "string",
            "description": "所属工作区编号（如果有的话）",
            "example": "workspace-01"
          },
          "provider": {
            "type": "string",
            "description": "这个对话使用的 AI 服务商名称",
            "example": "anthropic"
          },
          "model": {
            "type": "string",
            "description": "这个对话使用的 AI 模型名称",
            "example": "[REDACTED]"
          },
          "createdAt": {
            "type": "integer",
            "description": "创建时间，Unix 时间戳（毫秒）。Unix 时间戳是从 1970 年 1 月 1 日开始算的毫秒数",
            "example": 1724745600000
          },
          "updatedAt": {
            "type": "integer",
            "description": "最后修改时间，Unix 时间戳（毫秒）",
            "example": 1724745900000
          }
        }
      },
      "Message": {
        "type": "object",
        "description": "一条消息记录",
        "properties": {
          "id": {
            "type": "string",
            "description": "这条消息的唯一编号",
            "example": "msg_01ABC"
          },
          "role": {
            "type": "string",
            "description": "消息是谁发的。user 是用户，assistant 是 AI，tool 是工具执行结果",
            "enum": ["user", "assistant", "tool"],
            "example": "user"
          },
          "content": {
            "description": "消息内容，可能是纯文字字符串，也可能是包含多种内容块的数组（文字、图片、工具调用等）",
            "oneOf": [
              {
                "type": "string",
                "example": "帮我写一个爬虫"
              },
              {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            ]
          }
        }
      },
      "Session": {
        "allOf": [
          { "$ref": "#/components/schemas/SessionMeta" },
          {
            "type": "object",
            "description": "对话的完整内容，包含消息历史",
            "properties": {
              "history": {
                "type": "array",
                "description": "这个对话里所有消息的列表，按时间顺序排列",
                "items": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          }
        ]
      },
      "Provider": {
        "type": "object",
        "description": "一个 AI 服务商的配置信息",
        "properties": {
          "name": {
            "type": "string",
            "description": "服务商名称，用于识别身份",
            "example": "anthropic"
          },
          "baseURL": {
            "type": "string",
            "description": "服务商 API 的网址",
            "example": "https://api.anthropic.com"
          },
          "apiKey": {
            "type": "string",
            "description": "调用这个服务商需要的密钥",
            "example": "sk-ant-xxxxx"
          },
          "models": {
            "type": "array",
            "description": "这个服务商下可以使用的模型列表",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "example": "[REDACTED]"
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "[REDACTED]"
                    }
                  }
                }
              ]
            }
          },
          "enabled": {
            "type": "boolean",
            "description": "这个服务商是否启用。不填时默认启用",
            "example": true
          },
          "protocol": {
            "type": "string",
            "description": "服务商使用的通信协议。openai-compatible 表示兼容 OpenAI 格式的接口",
            "example": "openai-compatible"
          },
          "headers": {
            "description": "调用这个服务商时需要额外附带的 HTTP 请求头（可选）",
            "oneOf": [
              { "type": "object" },
              { "type": "string" }
            ]
          }
        }
      },
      "Config": {
        "type": "object",
        "description": "服务器的全局配置",
        "properties": {
          "providers": {
            "type": "array",
            "description": "所有 AI 服务商的配置列表",
            "items": {
              "$ref": "#/components/schemas/Provider"
            }
          },
          "prompt": {
            "type": "object",
            "description": "系统提示词配置",
            "properties": {
              "system": {
                "type": "string",
                "description": "发给 AI 的系统提示词，用于设定 AI 的行为方式",
                "example": "你是一个编程助手，帮用户解决代码问题。"
              },
              "tool": {
                "type": "string",
                "description": "关于工具使用的额外提示词（可选）"
              }
            }
          },
          "permission": {
            "description": "工具调用的审批规则配置（可选）。填写后，AI 在调用某些工具时会先向用户请求审批",
            "type": "object"
          }
        }
      }
    }
  }
}
