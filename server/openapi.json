{
  "openapi": "3.1.0",
  "info": {
    "title": "Universal Agent 后端接口文档",
    "version": "0.6.0",
    "description": "这个文档列出了所有可以调用的接口。每个接口都说明了：要发什么数据、会收到什么数据、以及这个接口是做什么用的。"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "本地开发服务器，默认端口 3000"
    }
  ],
  "tags": [
    {
      "name": "Status",
      "description": "确认后端是否可用。"
    },
    {
      "name": "Workspace",
      "description": "读取 agent 工作的目录、文件列表和 git 状态。"
    },
    {
      "name": "Agent",
      "description": "控制 AI 执行任务。启动任务、停止任务、审批工具调用。"
    },
    {
      "name": "Session",
      "description": "管理对话记录。创建、读取、重命名、删除对话，以及撤销和压缩历史消息。"
    },
    {
      "name": "Config",
      "description": "读取和保存全局配置，比如 AI 模型和系统提示词。"
    },
    {
      "name": "SSE",
      "description": "建立实时事件连接。服务器会持续把 AI 的输出推送给你。SSE 是 Server-Sent Events 的缩写，意思是服务器主动推送消息。"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Status"],
        "summary": "查询服务是否可用",
        "description": "前端启动时先打这个接口：能拿到 version 就说明后端在，连不上就是后端没起来。同时给出内存里的会话数量和正在运行的任务数量。",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "服务正常",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean", "example": true },
                    "version": { "type": "string", "description": "后端版本号，来自 package.json", "example": "0.3.0" },
                    "sessions": { "type": "integer", "description": "已经加载进内存的会话数量" },
                    "running": { "type": "integer", "description": "正在执行任务的会话数量" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/workspace/read": {
      "get": {
        "tags": ["Workspace"],
        "summary": "读取当前工作区信息",
        "description": "返回后端进程当前所在目录、这个目录下的文件列表（最多 200 个，已排除依赖和构建目录）以及 git 状态。对话里的 agent 需要这份信息才知道自己在哪个项目里工作。",
        "operationId": "workspaceRead",
        "responses": {
          "200": {
            "description": "工作区信息",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string", "example": "D:/projects/app" },
                    "files": { "type": "array", "items": { "type": "string" }, "description": "工作区里的文件相对路径" },
                    "git": {
                      "description": "git 状态；不是 git 仓库时是 null",
                      "oneOf": [
                        { "type": "null" },
                        {
                          "type": "object",
                          "properties": {
                            "branch": { "type": "string", "example": "main" },
                            "changed": { "type": "integer", "description": "有改动的文件总数" },
                            "modified": { "type": "integer" },
                            "added": { "type": "integer" },
                            "deleted": { "type": "integer" },
                            "untracked": { "type": "integer" }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/workspace/status": {
      "get": {
        "tags": ["Workspace"],
        "summary": "读取某个目录的 git 状态",
        "description": "只想看某个子目录的分支和改动数量时用它。不是 git 仓库时 git 字段是 null。",
        "operationId": "workspaceStatus",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": false,
            "description": "要检查的目录，不传就是后端进程的当前目录",
            "schema": { "type": "string", "example": "D:/projects/app" }
          }
        ],
        "responses": {
          "200": {
            "description": "目录的 git 状态",
            "content": {
              "application/json": {
                "schema": { "type": ["object", "null"] }
              }
            }
          }
        }
      }
    },
    "/agent/send/{sessionId}": {
      "post": {
        "tags": ["Agent"],
        "summary": "发送消息，启动 AI 任务",
        "description": "向指定会话发送一条用户消息，AI 会在后台开始工作。任务执行过程中的所有输出，都会通过 GET /sse/connect/{sessionId} 推送过来，这个接口本身只返回 { ok: true }。同一个会话同时只能运行一个任务，重复调用会返回 409 错误。",
        "operationId": "agentSend",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "description": "会话的唯一编号，由 POST /session/create 创建时返回",
            "schema": {
              "type": "string",
              "example": "V1StGXR8_Z5jdHi6B-myT"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["input"],
                "properties": {
                  "input": {
                    "type": "string",
                    "description": "你要发给 AI 的消息内容，不能为空",
                    "example": "帮我写一个读取文件的 Python 脚本"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已成功启动，AI 开始在后台运行",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求数据有问题，比如 input 是空字符串",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "404": {
            "description": "找不到这个 sessionId 对应的会话",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "409": {
            "description": "这个会话的 AI 任务已经在运行中，不能同时启动第二个",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/agent/stop/{sessionId}": {
      "post": {
        "tags": ["Agent"],
        "summary": "停止正在运行的 AI 任务",
        "description": "立即终止指定会话中正在执行的 AI 任务。如果这个会话当前没有任务在运行，返回 { ok: false }；停止成功返回 { ok: true }。",
        "operationId": "agentStop",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "description": "会话的唯一编号",
            "schema": {
              "type": "string",
              "example": "V1StGXR8_Z5jdHi6B-myT"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "操作完成。ok 为 true 表示成功停止，ok 为 false 表示当前没有任务在运行",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/agent/decide/{sessionId}": {
      "post": {
        "tags": ["Agent"],
        "summary": "审批 AI 使用工具的请求",
        "description": "当 AI 需要调用某个工具时，如果权限规则要求询问，服务器会通过 SSE 推送一个 permission 事件，里面包含 callID。你需要调用这个接口告诉服务器放行还是拒绝。decision 只能是 allow-once（只允许本次）、allow-always（本次允许并记住这类操作）或 deny（拒绝）。",
        "operationId": "agentDecide",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "description": "会话的唯一编号",
            "schema": {
              "type": "string",
              "example": "V1StGXR8_Z5jdHi6B-myT"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["toolCallId", "decision"],
                "properties": {
                  "toolCallId": {
                    "type": "string",
                    "description": "工具调用的编号，从 SSE permission 事件的 callID 字段获取",
                    "example": "toolu_01XFx8EsZFm5kMvW8s6TuGHq"
                  },
                  "decision": {
                    "type": "string",
                    "enum": ["allow-once", "allow-always", "deny"],
                    "description": "allow-once 只允许本次调用，allow-always 本次允许并把这类参数写成规则，deny 拒绝",
                    "example": "allow-once"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "审批结果已处理。ok 为 true 表示找到了对应的等待审批记录，ok 为 false 表示找不到（可能已经超时或被取消）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "decision 不是 allow-once、allow-always、deny 中的一个"
          }
        }
      }
    },
    "/sse/connect/{sessionId}": {
      "get": {
        "tags": ["SSE"],
        "summary": "建立实时事件连接，接收 AI 的输出",
        "description": "建立一个持续的连接，服务器会把 AI 运行过程中的所有事件推送过来。连接断开后会自动重连，之前没收到的事件也会补发。这个连接没有固定的结束时间，会一直保持直到你主动断开。\n\n服务器推送的事件类型如下：\n- **agent-start**：AI 任务开始\n- **text-delta**：AI 正在生成文字，每次推送一小段\n- **reasoning-delta**：AI 正在思考，每次推送一小段\n- **llm-start** / **llm-finish**：一次模型请求开始 / 结束，finish 里带完整文字和用量\n- **tool-call**：AI 正在调用某个工具\n- **tool-output**：工具的实时输出，stream 是 stdout 或 stderr\n- **tool-result**：工具执行的最终结果\n- **permission**：AI 请求你审批是否允许使用某个工具\n- **retry**：因为错误正在重试\n- **compact-start** / **compact-finish**：AI 正在压缩历史记录，过程中推送事件\n- **agent-finish**：任务结束，带上结束原因和用量；任务失败时带 error 字段",
        "operationId": "sseConnect",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "description": "会话的唯一编号",
            "schema": {
              "type": "string",
              "example": "V1StGXR8_Z5jdHi6B-myT"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功建立 SSE 连接，服务器开始推送事件",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "SSE 格式的事件流。每个事件是一段 JSON 数据，格式为 data: {...}\\n\\n",
                  "example": "data: {\"type\":\"text-delta\",\"text\":\"好的，\"}\n\ndata: {\"type\":\"finish\",\"steps\":1}\n\n"
                },
                "examples": {
                  "text-delta": {
                    "summary": "AI 生成文字的片段",
                    "value": "data: {\"type\":\"text-delta\",\"text\":\"好的，我来帮你\"}\n\n"
                  },
                  "tool-call": {
                    "summary": "AI 调用工具",
                    "value": "data: {\"type\":\"tool-call\",\"toolCallId\":\"toolu_01\",\"toolName\":\"read_file\",\"args\":{\"path\":\"./index.js\"}}\n\n"
                  },
                  "permission": {
                    "summary": "AI 请求审批工具调用",
                    "value": "data: {\"type\":\"permission\",\"callID\":\"toolu_01\",\"tool\":\"delete_file\",\"input\":{\"path\":\"./old.js\"}}\n\n"
                  },
                  "finish": {
                    "summary": "任务完成",
                    "value": "data: {\"type\":\"finish\",\"steps\":3,\"usage\":{\"promptTokens\":1200,\"completionTokens\":400}}\n\n"
                  },
                  "error": {
                    "summary": "任务出错",
                    "value": "data: {\"type\":\"error\",\"message\":\"Provider not found: openai\",\"name\":\"Error\"}\n\n"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/session/list": {
      "get": {
        "tags": ["Session"],
        "summary": "列出磁盘上的全部会话",
        "description": "前端启动时用它填充侧边栏。只返回会话元信息，不返回历史，所以很快。会话存在磁盘上，因此换台机器、换浏览器、清掉缓存都能找回自己的会话。最近用过的排在前面。",
        "operationId": "sessionList",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "按标题或模型名筛选，不传就是全部",
            "schema": { "type": "string", "example": "爬虫" }
          }
        ],
        "responses": {
          "200": {
            "description": "会话元信息列表，按最近更新时间从新到旧",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/SessionMeta" }
                }
              }
            }
          }
        }
      }
    },
    "/session/create": {
      "post": {
        "tags": ["Session"],
        "summary": "新建一个对话",
        "description": "创建一个新的对话，返回这个对话的唯一编号 sessionId。之后所有操作都用这个编号来指定是哪个对话。",
        "operationId": "sessionCreate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title"],
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "这个对话的名称，不能为空",
                    "example": "写爬虫"
                  },
                  "workspaceId": {
                    "type": "string",
                    "description": "工作区编号（可选）",
                    "example": "workspace-01"
                  },
                  "provider": {
                    "type": "string",
                    "description": "指定使用哪个 AI 服务商（可选）。不填时使用配置里第一个启用的服务商",
                    "example": "anthropic"
                  },
                  "model": {
                    "type": "string",
                    "description": "指定使用哪个 AI 模型（可选）。不填时使用该服务商的第一个模型",
                    "example": "[REDACTED]"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "对话创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sessionId": {
                      "type": "string",
                      "description": "新建对话的唯一编号，后续所有操作都需要这个值",
                      "example": "V1StGXR8_Z5jdHi6B-myT"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "title 不能为空或不是字符串",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/session/read/{sessionId}": {
      "get": {
        "tags": ["Session"],
        "summary": "读取一个对话的全部内容",
        "description": "返回这个对话的基本信息和完整的消息历史记录。history 是一个消息列表，每条消息都有 role（角色）和 content（内容）。",
        "operationId": "sessionRead",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "description": "会话的唯一编号",
            "schema": {
              "type": "string",
              "example": "V1StGXR8_Z5jdHi6B-myT"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回对话信息",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "404": {
            "description": "找不到这个 sessionId 对应的对话",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/session/rename/{sessionId}": {
      "patch": {
        "tags": ["Session"],
        "summary": "给对话改名",
        "description": "修改指定对话的名称，返回更新后的对话信息（不含消息历史）。",
        "operationId": "sessionRename",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "description": "会话的唯一编号",
            "schema": {
              "type": "string",
              "example": "V1StGXR8_Z5jdHi6B-myT"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title"],
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "新的对话名称，不能为空",
                    "example": "写爬虫脚本"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "改名成功，返回更新后的对话基本信息",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionMeta"
                }
              }
            }
          },
          "400": {
            "description": "title 不能为空",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "404": {
            "description": "找不到这个 sessionId",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/session/remove/{sessionId}": {
      "delete": {
        "tags": ["Session"],
        "summary": "删除一个对话",
        "description": "永久删除指定的对话及其所有消息记录。这个操作不可撤销。",
        "operationId": "sessionRemove",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "description": "会话的唯一编号",
            "schema": {
              "type": "string",
              "example": "V1StGXR8_Z5jdHi6B-myT"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "找不到这个 sessionId",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/session/rollback/{sessionId}": {
      "post": {
        "tags": ["Session"],
        "summary": "回退到某条消息之前的状态",
        "description": "回退到指定 messageId 之前的状态。同时回退两样东西：对话消息，以及 agent 通过工具改过的文件——文件会被恢复成那一刻的样子，任务期间新建的文件会被删掉。这个操作要求会话当前没有任务在运行，否则返回 409；messageId 不在这个会话里时返回 404。",
        "operationId": "sessionRollback",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "description": "会话的唯一编号",
            "schema": {
              "type": "string",
              "example": "V1StGXR8_Z5jdHi6B-myT"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["messageId"],
                "properties": {
                  "messageId": {
                    "type": "string",
                    "description": "要回退到这条消息之前。这条消息和它之后的所有消息都会被移除",
                    "example": "msg_01ABC"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "回退成功，返回回退后的完整对话内容；restored 是被恢复的文件路径列表",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/Session" },
                    {
                      "type": "object",
                      "properties": {
                        "restored": {
                          "type": "array",
                          "items": { "type": "string" },
                          "description": "被恢复到这一步之前的文件路径；没改过文件时是空数组",
                          "example": ["D:/projects/app/src/main.js"]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "找不到这个 sessionId，或 messageId 不在这个会话的历史里",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "409": {
            "description": "这个会话的 AI 任务正在运行，需要先停止再回退",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/session/changes/{sessionId}": {
      "get": {
        "tags": ["Session"],
        "summary": "看 agent 改了哪些文件",
        "description": "返回 agent 到目前为止改动过的文件，每个都给出改动前和改动后的完整内容，界面可以据此显示 diff。数据来自文件快照，和回退能看到的是同一件事。内容没变过的文件不会出现在结果里。",
        "operationId": "sessionChanges",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "description": "会话的唯一编号",
            "schema": { "type": "string", "example": "V1StGXR8_Z5jdHi6B-myT" }
          }
        ],
        "responses": {
          "200": {
            "description": "改动列表；没改过任何文件时是空数组",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": { "type": "string", "description": "文件的绝对路径" },
                      "before": { "type": "string", "description": "任务开始时这个文件的内容；原来是新建的就是空串" },
                      "after": { "type": "string", "description": "当前内容；被删掉的就是空串" },
                      "added": { "type": "boolean", "description": "这个文件是任务期间新建的" },
                      "deleted": { "type": "boolean", "description": "这个文件被删掉了" }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "找不到这个 sessionId",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/session/redo/{sessionId}": {
      "post": {
        "tags": ["Session"],
        "summary": "撤销上一次回退",
        "description": "把刚才通过 rollback 移除的消息重新恢复回来。只能撤销最近一次回退。",
        "operationId": "sessionRedo",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "description": "会话的唯一编号",
            "schema": {
              "type": "string",
              "example": "V1StGXR8_Z5jdHi6B-myT"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "撤销回退成功，返回恢复后的完整对话内容",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "404": {
            "description": "找不到这个 sessionId",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/session/compact/{sessionId}": {
      "post": {
        "tags": ["Session"],
        "summary": "压缩对话历史，减少 token 用量",
        "description": "让 AI 把当前上下文总结成一段文字，总结作为一条新消息追加到历史里，原文仍然保留在磁盘上。压缩过程通过 SSE 推送 compact-start、AI SDK 原生事件和 compact-finish。会话正在运行时返回 409。",
        "operationId": "sessionCompact",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "description": "会话的唯一编号",
            "schema": {
              "type": "string",
              "example": "V1StGXR8_Z5jdHi6B-myT"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "压缩完成，返回压缩后的完整对话内容，另带 content 字段是这次的总结文本",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "404": {
            "description": "找不到这个 sessionId",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "409": {
            "description": "这个会话的 AI 任务正在运行，需要先停止再压缩",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/config/read": {
      "get": {
        "tags": ["Config"],
        "summary": "读取当前全局配置",
        "description": "返回服务器当前正在使用的全部配置，包括 AI 服务商、模型列表、系统提示词、权限规则等。",
        "operationId": "configRead",
        "responses": {
          "200": {
            "description": "成功返回当前配置",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Config"
                }
              }
            }
          }
        }
      }
    },
    "/config/test": {
      "post": {
        "tags": ["Config"],
        "summary": "真实试一次模型请求",
        "description": "用已保存的供应商配置发一条最小请求，确认请求地址、密钥和模型名能不能用。设置页的「测试连接」按钮走这个接口。不传参数就用配置里第一个启用的供应商。",
        "operationId": "configTest",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "provider": { "type": "string", "description": "供应商名称，不传就用第一个启用的" },
                  "model": { "type": "string", "description": "模型名称，不传就用该供应商的第一个模型" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "请求成功，模型返回了内容",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean", "example": true },
                    "provider": { "type": "string" },
                    "model": { "type": "string" },
                    "text": { "type": "string", "description": "模型返回的文字" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "供应商不存在，或者配置里没有任何模型可以试",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/config/set": {
      "patch": {
        "tags": ["Config"],
        "summary": "保存新的全局配置",
        "description": "用你提交的配置完全替换当前配置，并写入磁盘。注意：这是完全替换，不是合并，提交的内容就是保存后的内容，原来的配置不会保留。",
        "operationId": "configSet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Config"
              },
              "example": {
                "providers": [
                  {
                    "name": "anthropic",
                    "baseURL": "https://api.anthropic.com",
                    "apiKey": "sk-ant-xxxxx",
                    "models": ["[REDACTED]"],
                    "enabled": true
                  }
                ],
                "prompt": {
                  "system": "你是一个编程助手。"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "配置保存成功，返回保存后的完整配置",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Config"
                }
              }
            }
          },
          "400": {
            "description": "提交的数据不是一个合法的 JSON 对象",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "description": "接口出错时返回的错误信息",
        "properties": {
          "error": {
            "type": "string",
            "description": "错误的文字说明",
            "example": "Session not found: V1StGXR8_Z5jdHi6B-myT"
          }
        }
      },
      "SessionMeta": {
        "type": "object",
        "description": "对话的基本信息，不含消息历史",
        "properties": {
          "id": {
            "type": "string",
            "description": "对话的唯一编号",
            "example": "V1StGXR8_Z5jdHi6B-myT"
          },
          "title": {
            "type": "string",
            "description": "对话名称",
            "example": "写爬虫"
          },
          "workspaceId": {
            "type": "string",
            "description": "所属工作区编号（如果有的话）",
            "example": "workspace-01"
          },
          "provider": {
            "type": "string",
            "description": "这个对话使用的 AI 服务商名称",
            "example": "anthropic"
          },
          "model": {
            "type": "string",
            "description": "这个对话使用的 AI 模型名称",
            "example": "[REDACTED]"
          },
          "createdAt": {
            "type": "integer",
            "description": "创建时间，Unix 时间戳（毫秒）。Unix 时间戳是从 1970 年 1 月 1 日开始算的毫秒数",
            "example": 1724745600000
          },
          "updatedAt": {
            "type": "integer",
            "description": "最后修改时间，Unix 时间戳（毫秒）",
            "example": 1724745900000
          }
        }
      },
      "Message": {
        "type": "object",
        "description": "一条消息记录。messageId 是后端记录用的身份（回退时传它），id 是消息块自己的身份",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "后端记录这条消息用的唯一编号，回退接口接收的就是它",
            "example": "V1StGXR8_Z5jdHi6B-myT"
          },
          "id": {
            "type": "string",
            "description": "消息块的唯一编号",
            "example": "msg_01ABC"
          },
          "role": {
            "type": "string",
            "description": "消息是谁发的。user 是用户，assistant 是 AI，tool 是工具执行结果",
            "enum": ["user", "assistant", "tool"],
            "example": "user"
          },
          "content": {
            "description": "消息内容，可能是纯文字字符串，也可能是包含多种内容块的数组（文字、图片、工具调用等）",
            "oneOf": [
              {
                "type": "string",
                "example": "帮我写一个爬虫"
              },
              {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            ]
          }
        }
      },
      "Session": {
        "allOf": [
          { "$ref": "#/components/schemas/SessionMeta" },
          {
            "type": "object",
            "description": "对话的完整内容，包含消息历史",
            "properties": {
              "history": {
                "type": "array",
                "description": "这个对话里所有消息的列表，按时间顺序排列",
                "items": {
                  "$ref": "#/components/schemas/Message"
                }
              },
              "todos": {
                "type": "array",
                "description": "agent 最近一次调用 todo 工具写下的任务清单，直接从历史里取出来，界面可以直接渲染进度",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": { "type": "string", "description": "这一步要做什么" },
                    "status": { "type": "string", "enum": ["pending", "in_progress", "completed"] }
                  }
                },
                "example": [
                  { "text": "读现有实现", "status": "completed" },
                  { "text": "改 session 指令", "status": "in_progress" }
                ]
              },
              "running": {
                "type": "boolean",
                "description": "这个会话现在有没有任务在跑"
              }
            }
          }
        ]
      },
      "Provider": {
        "type": "object",
        "description": "一个 AI 服务商的配置信息",
        "properties": {
          "name": {
            "type": "string",
            "description": "服务商名称，用于识别身份",
            "example": "anthropic"
          },
          "baseURL": {
            "type": "string",
            "description": "服务商 API 的网址",
            "example": "https://api.anthropic.com"
          },
          "apiKey": {
            "type": "string",
            "description": "调用这个服务商需要的密钥",
            "example": "sk-ant-xxxxx"
          },
          "models": {
            "type": "array",
            "description": "这个服务商下可以使用的模型列表",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "example": "[REDACTED]"
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "[REDACTED]"
                    }
                  }
                }
              ]
            }
          },
          "enabled": {
            "type": "boolean",
            "description": "这个服务商是否启用。不填时默认启用",
            "example": true
          },
          "protocol": {
            "type": "string",
            "description": "服务商使用的通信协议。openai-compatible 表示兼容 OpenAI 格式的接口",
            "example": "openai-compatible"
          },
          "headers": {
            "description": "调用这个服务商时需要额外附带的 HTTP 请求头（可选）",
            "oneOf": [
              { "type": "object" },
              { "type": "string" }
            ]
          }
        }
      },
      "Config": {
        "type": "object",
        "description": "服务器的全局配置",
        "properties": {
          "providers": {
            "type": "array",
            "description": "所有 AI 服务商的配置列表",
            "items": {
              "$ref": "#/components/schemas/Provider"
            }
          },
          "prompt": {
            "type": "object",
            "description": "系统提示词配置",
            "properties": {
              "system": {
                "type": "string",
                "description": "发给 AI 的系统提示词，用于设定 AI 的行为方式",
                "example": "你是一个编程助手，帮用户解决代码问题。"
              },
            }
          },
          "permission": {
            "type": "object",
            "description": "工具权限规则。键是工具名，值是 allow、ask，或按参数匹配的对象；为空对象时所有工具都先问用户。这一层管不住的文件由数据目录的 .agentignore 兜底",
            "example": {
              "*": "ask",
              "file_read": "allow",
              "shell": { "*": "ask", "dir": "allow" }
            }
          },
          "mcp": {
            "type": "object",
            "description": "外部工具服务（MCP）。键是服务名，工具名会带上服务名前缀；配置改动后下次建会话时连接跟着变。某个服务连不上只会跳过它，不影响会话创建",
            "example": {
              "everything": {
                "command": "bun",
                "args": ["node_modules/@modelcontextprotocol/server-everything/dist/index.js"],
                "enabled": true
              }
            }
          }
        }
      }
    }
  }
}
