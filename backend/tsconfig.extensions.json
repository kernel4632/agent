{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "lib": ["ES2023"],
    "types": ["bun-types"],
    "paths": {
      "agent-backend": ["./extension.d.ts"],
      "@kernel4632/agent-core": ["./node_modules/@kernel4632/agent-core/dist/types/index.d.ts"]
    }
  },
  "include": ["../extensions/*/backend.js", "../extensions/*/tools/*.js"]
}
