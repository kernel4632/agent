/*
server.js 路由参考：在当前文件直接注册最小 Agent API，不建立 routes 文件夹。
路由只提取请求参数并调用 commands；commands 负责修改 store 和持久化。
调用示例：bun run server.js。
*/
import { Elysia } from 'elysia'                    // 引入 HTTP 服务和路由能力
import { Config } from './commands/config'        // 引入配置读取和修改指令
import { Workspace } from './commands/workspace'  // 引入工作区管理指令
import { Session } from './commands/session'      // 引入会话管理和 SSE 监听指令
import { Agent } from './commands/agent'          // 引入消息发送和停止指令

// --- 加载持久化数据 ---
await Config.load()                               // 加载供应商和工具配置
await Workspace.load()                            // 加载工作区和会话摘要


// --- 注册最小 Agent API ---
new Elysia()
    .get('/health', () => ({ status: 'ok' }))                                                   // 返回服务存活状态
    .get('/config', () => Config.get())                                                         // 返回完整配置
    .patch('/config', ({ body }) => Config.update(body))                                        // 合并并保存配置
    .get('/workspace', () => Workspace.list())                                                  // 返回工作区和会话摘要
    .post('/workspace', ({ body }) => Workspace.add(body.path))                                 // 添加本地工作区
    .delete('/workspace', ({ query }) => Workspace.remove(query.id))                            // 按 query id 移除工作区记录
    .get('/session', ({ query }) => Session.get(query.id))                                      // 返回完整会话
    .post('/session', ({ body }) => Session.create(body.workspaceId, body.provider, body.model)) // 创建会话和工作区摘要
    .patch('/session', ({ body }) => Session.update(body.id, body.title, body.provider, body.model)) // 修改标题、供应商或模型
    .delete('/session', ({ query }) => Session.remove(query.id))                                // 停止并删除会话
    .get('/session/events', ({ query }) => Session.listen(query.id))                            // 建立会话 SSE 连接
    .post('/session/send', ({ body }) => Agent.send(body.id, body.content))                     // 保存用户消息并后台启动 Agent
    .post('/session/stop', ({ body }) => Agent.stop(body.id))                                   // 停止模型请求和全部工具进程
    .onError(({ code, error, status }) => {                                                     // 统一返回简单错误对象
        if (code === 'NOT_FOUND') return status(404, { error: 'Not Found' })                    // 未知路由明确返回 404
        return status(error.status || 500, { error: error.message })                            // 业务错误保留状态，未知错误返回 500
    })
    .listen(4632)                                                                                // 在固定端口接受前端请求
