{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "types": [],
    "paths": {
      "vue": ["./../web/node_modules/vue"],
      "agent-extension": ["./../web/src/types.ts"],
      "@kernel4632/agent-core": ["./../web/node_modules/@kernel4632/agent-core/dist/types/index.d.ts"],
      "@hugeicons/core-free-icons": ["./../web/node_modules/@hugeicons/core-free-icons"]
    }
  },
  "include": ["*/frontend/**/*.js", "*/frontend/**/*.vue"]
}
